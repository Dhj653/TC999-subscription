# ===== face_service 环境配置 =====
# 复制为 .env 后填写实际值

# 服务端口
SERVICE_PORT=5002
SERVICE_HOST=127.0.0.1

# 萤核原版 SQLite 数据库路径（复用萤核数据库，仅新增表）
# Windows 示例：C:/Users/你的用户名/AppData/Roaming/firefly-ai-folder-cn/data.db
FIREFLY_DB_PATH=./data.db

# 外挂服务自身运行日志文件
LOG_FILE=./logs/face_service.log
LOG_LEVEL=INFO

# ===== InsightFace 本地模型 =====
# 模型根目录（手动放置 antelopev2 / buffalo_l / buffalo_s 模型包）
# 避免首次运行自动下载；若目录下找不到对应模型则报错退出
INSIGHTFACE_ROOT=./models
# 使用的检测模型包名（buffalo_l 含检测+性别年龄+识别）
INSIGHTFACE_CTX=0
# 是否禁止联网下载模型（True=强制本地，False=允许自动下载）
DISABLE_MODEL_DOWNLOAD=true

# ===== 人脸过滤 =====
# 性别过滤：仅保留女性（female）
FACE_GENDER_KEEP=female
# InsightFace buffalo_l genderage 约定：0=女性 1=男性。
# 若实测发现性别过滤反了，改成 1 即可，无需改代码。
FACE_GENDER_FEMALE_VALUE=0
# 正脸 yaw 角度阈值（度），超过则判为侧脸丢弃
FACE_YAW_THRESHOLD=35
# 模糊度阈值（拉普拉斯方差），低于则判为模糊丢弃
FACE_BLUR_THRESHOLD=80
# 人脸检测置信度阈值
FACE_DET_SCORE=0.5

# ===== 聚类 =====
# 人脸相似度阈值（0~1，越大越严格），前端滑块可运行时调节
FACE_SIMILARITY_THRESHOLD=0.55

# ===== 视频 =====
# 抽帧间隔（秒），每 N 秒抽 1 帧
VIDEO_FRAME_INTERVAL=2
# 单视频最多抽取帧数，防止超长视频爆内存
VIDEO_MAX_FRAMES=60

# ===== 输出 =====
# 测试预览模式默认开启（True=只预览不移动文件）
TEST_PREVIEW_MODE=true

# ===== 路径安全 =====
# 禁止输出到这些根目录（系统盘根、Program Files、Windows 等）
BLOCKED_PATH_ROOTS=C:\Windows,C:\Program Files,C:\Program Files (x86),C:\ProgramData
