# ===== face_service 环境配置 =====
# 复制为 .env 后填写实际值

# ===== 服务 =====
SERVICE_PORT=5002
SERVICE_HOST=127.0.0.1

# ===== 数据库（复用萤核 SQLite，仅新增表）=====
# Windows 示例：C:/Users/你的用户名/AppData/Roaming/firefly-ai-folder-cn/data.db
# 或使用外挂自带路径：./data/face_service.db
FIREFLY_DB_PATH=./data/face_service.db

# ===== 日志 =====
LOG_FILE=./logs/face_service.log
LOG_LEVEL=INFO

# ===== InsightFace 本地模型 =====
# 模型根目录：应包含 models/buffalo_l/*.onnx
INSIGHTFACE_ROOT=./models
INSIGHTFACE_CTX=0
# True=强制本地找不到就报错退出；False=允许 InsightFace 自动联网下载
DISABLE_MODEL_DOWNLOAD=false

# ===== 人脸过滤 =====
FACE_GENDER_KEEP=female
# buffalo_l genderage: 0=女性 1=男性
FACE_GENDER_FEMALE_VALUE=0
# 正脸 yaw/roll 阈值（度），超过判侧脸丢弃
FACE_YAW_THRESHOLD=35
# 戴口罩放宽：若 5 点关键点不全或质量差（口罩可能），自动使用宽松阈值
FACE_YAW_MASK_THRESHOLD=55
# 模糊度阈值（拉普拉斯方差），低于丢弃
FACE_BLUR_THRESHOLD=80
# 戴口罩放宽的模糊度阈值
FACE_BLUR_MASK_THRESHOLD=40
# 人脸检测置信度阈值
FACE_DET_SCORE=0.5
# 是否启用戴口罩兼容模式（默认true：关键点质量差时自动放宽阈值）
FACE_MASK_TOLERANT=true

# ===== 聚类 =====
# 人脸相似度阈值（0~1），前端滑块可调
FACE_SIMILARITY_THRESHOLD=0.55
# 【新功能】建文件夹阈值：同一角色视频数 >= 该值才创建文件夹并移动
# （需求：检测到 2 个相同女性才建夹）
FOLDER_CREATE_MIN_VIDEOS=2
# 单人视频（< FOLDER_CREATE_MIN_VIDEOS）处理策略：
#   "keep_in_place" = 留在原位不动（等待后续视频）
#   "to_uncategorized" = 统一移动到 "未分类" 子文件夹
SINGLE_VIDEO_POLICY=keep_in_place
# 未分类子文件夹名称（仅当 SINGLE_VIDEO_POLICY=to_uncategorized 时生效）
UNCATEGORIZED_DIR_NAME=_未分类_待补充

# ===== 视频 =====
VIDEO_FRAME_INTERVAL=2     # 抽帧间隔（秒）
VIDEO_MAX_FRAMES=60        # 单视频最多抽帧数（防超长视频爆内存）
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ===== 输出 =====
TEST_PREVIEW_MODE=true     # 测试预览模式默认开启（True=只预览不移动文件）
# 缩略图保存目录（角色人脸缩略图）
THUMBNAIL_DIR=./thumbnails

# ===== 路径安全 =====
# 禁止输出到这些根目录（逗号分隔）
BLOCKED_PATH_ROOTS=C:\Windows,C:\Program Files,C:\Program Files (x86),C:\ProgramData

# ===== 【新增】视频内容去重（画面完全相同才判定为重复）=====
DEDUP_ENABLED=true                  # 是否启用视频自动去重
DEDUP_KEYFRAMES=5                   # 每个视频抽几帧做感知哈希（越多越严格）
DEDUP_DURATION_TOLERANCE_SEC=2      # 两个视频时长差 ≤ 该值（秒）才可能判定为重复
DEDUP_MIN_HASH_MATCHES=5            # 至少几帧的 dHash 完全一致才判定重复（默认=关键帧数，要求100%）
DEDUP_REPEAT_FOLDER_NAME=_重复文件_  # 重复视频归档根目录名（在所属角色目录下创建）
DEDUP_NESTING=true                  # 若重复文件夹内仍存在互相重复，是否在其下再建子目录嵌套归档
